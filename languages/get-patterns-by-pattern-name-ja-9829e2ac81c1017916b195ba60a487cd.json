{"translation-revision-date":"2026-10-06 20:30+0900","generator":"WP-CLI\/2.12.0","source":"blocks\/pattern\/index.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ja","plural-forms":"nplurals=1; plural=0;"},"Synced pattern":["\u540c\u671f\u30d1\u30bf\u30fc\u30f3"],"Choose a synced pattern. Its name is saved in the block.":["\u540c\u671f\u30d1\u30bf\u30fc\u30f3\u3092\u9078\u3073\u307e\u3059\u3002\u30d6\u30ed\u30c3\u30af\u306b\u306f\u3001\u305d\u306e\u30d1\u30bf\u30fc\u30f3\u306e\u540d\u524d\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"],"No published pattern has the name or slug \"%s\".":["\u540d\u524d\u307e\u305f\u306f\u30b9\u30e9\u30c3\u30b0\u304c\u300c%s\u300d\u306e\u516c\u958b\u6e08\u307f\u30d1\u30bf\u30fc\u30f3\u306f\u3042\u308a\u307e\u305b\u3093\u3002"],"Could not look up the pattern.":["\u30d1\u30bf\u30fc\u30f3\u3092\u691c\u7d22\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"],"Name:":["\u540d\u524d:"],"Slug:":["\u30b9\u30e9\u30c3\u30b0:"],"Matched by name.":["\u540d\u524d\u3067\u4e00\u81f4\u3057\u307e\u3057\u305f\u3002"],"Matched by slug.":["\u30b9\u30e9\u30c3\u30b0\u3067\u4e00\u81f4\u3057\u307e\u3057\u305f\u3002"],"Use the slug instead":["\u30b9\u30e9\u30c3\u30b0\u3067\u6307\u5b9a\u3059\u308b"],"If the pattern is renamed later, a block that uses the slug keeps working.":["\u3042\u3068\u3067\u30d1\u30bf\u30fc\u30f3\u306e\u540d\u524d\u3092\u5909\u3048\u3066\u3082\u3001\u30b9\u30e9\u30c3\u30b0\u3067\u6307\u5b9a\u3057\u305f\u30d6\u30ed\u30c3\u30af\u306f\u8868\u793a\u3055\u308c\u7d9a\u3051\u307e\u3059\u3002"],"Another pattern (\"%s\") has this text as its slug. The pattern whose name matches is shown.":["\u5225\u306e\u30d1\u30bf\u30fc\u30f3(\u300c%s\u300d)\u306e\u30b9\u30e9\u30c3\u30b0\u304c\u3001\u3053\u306e\u6587\u5b57\u5217\u3068\u540c\u3058\u3067\u3059\u3002\u540d\u524d\u304c\u4e00\u81f4\u3059\u308b\u30d1\u30bf\u30fc\u30f3\u3092\u8868\u793a\u3057\u307e\u3059\u3002"],"Edit this pattern":["\u3053\u306e\u30d1\u30bf\u30fc\u30f3\u3092\u7de8\u96c6"],"Pattern by name or slug":["\u30d1\u30bf\u30fc\u30f3(\u540d\u524d\u307e\u305f\u306f\u30b9\u30e9\u30c3\u30b0)"],"This pattern cannot be displayed.":["\u3053\u306e\u30d1\u30bf\u30fc\u30f3\u306f\u8868\u793a\u3067\u304d\u307e\u305b\u3093\u3002"],"Pattern not found":["\u30d1\u30bf\u30fc\u30f3\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093"],"Pattern not found: %s":["\u30d1\u30bf\u30fc\u30f3\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093: %s"],"Pattern":["\u30d1\u30bf\u30fc\u30f3"],"Name or slug":["\u540d\u524d\u307e\u305f\u306f\u30b9\u30e9\u30c3\u30b0"],"The name is tried first. If no pattern has that name, the slug is tried.":["\u5148\u306b\u540d\u524d\u3067\u63a2\u3057\u3001\u305d\u306e\u540d\u524d\u306e\u30d1\u30bf\u30fc\u30f3\u304c\u306a\u3051\u308c\u3070\u30b9\u30e9\u30c3\u30b0\u3067\u63a2\u3057\u307e\u3059\u3002"]}}}