#: includes/rest-resolve.php:86
msgid "Pattern not found."
msgstr "パターンが見つかりません。"

#: blocks/pattern/index.js:144
msgid "Synced pattern"
msgstr "同期パターン"

#: blocks/pattern/index.js:145
msgid "Choose a synced pattern. Its name is saved in the block."
msgstr "同期パターンを選びます。ブロックには、そのパターンの名前が保存されます。"

#. translators: %s: the text entered in the block.
#: blocks/pattern/index.js:171
#, js-format
msgid "No published pattern has the name or slug \"%s\"."
msgstr "名前またはスラッグが「%s」の公開済みパターンはありません。"

#: blocks/pattern/index.js:178
#: blocks/pattern/index.js:276
msgid "Could not look up the pattern."
msgstr "パターンを検索できませんでした。"

#: blocks/pattern/index.js:190
msgid "Name:"
msgstr "名前:"

#: blocks/pattern/index.js:191
msgid "Slug:"
msgstr "スラッグ:"

#: blocks/pattern/index.js:196
msgid "Matched by name."
msgstr "名前で一致しました。"

#: blocks/pattern/index.js:197
msgid "Matched by slug."
msgstr "スラッグで一致しました。"

#: blocks/pattern/index.js:211
msgid "Use the slug instead"
msgstr "スラッグで指定する"

#: blocks/pattern/index.js:216
msgid "If the pattern is renamed later, a block that uses the slug keeps working."
msgstr "あとでパターンの名前を変えても、スラッグで指定したブロックは表示され続けます。"

#. translators: %s: name of another pattern.
#: blocks/pattern/index.js:225
#, js-format
msgid "Another pattern (\"%s\") has this text as its slug. The pattern whose name matches is shown."
msgstr "別のパターン(「%s」)のスラッグが、この文字列と同じです。名前が一致するパターンを表示します。"

#: blocks/pattern/index.js:230
msgid "Edit this pattern"
msgstr "このパターンを編集"

#: blocks/pattern/index.js:253
#: blocks/pattern/index.js:278
msgid "Pattern by name or slug"
msgstr "パターン(名前またはスラッグ)"

#: blocks/pattern/index.js:262
msgid "This pattern cannot be displayed."
msgstr "このパターンは表示できません。"

#: blocks/pattern/index.js:268
msgid "Pattern not found"
msgstr "パターンが見つかりません"

#. translators: %s: the text entered in the block.
#: blocks/pattern/index.js:271
#, js-format
msgid "Pattern not found: %s"
msgstr "パターンが見つかりません: %s"

#: blocks/pattern/index.js:289
msgid "Pattern"
msgstr "パターン"

#: blocks/pattern/index.js:294
msgid "Name or slug"
msgstr "名前またはスラッグ"

#: blocks/pattern/index.js:295
msgid "The name is tried first. If no pattern has that name, the slug is tried."
msgstr "先に名前で探し、その名前のパターンがなければスラッグで探します。"

#: blocks/pattern/block.json
msgctxt "block title"
msgid "Pattern by name or slug"
msgstr "パターン(名前またはスラッグ)"

#: blocks/pattern/block.json
msgctxt "block keyword"
msgid "pattern"
msgstr "パターン"

#: blocks/pattern/block.json
msgctxt "block keyword"
msgid "synced"
msgstr "同期"

#: blocks/pattern/block.json
msgctxt "block keyword"
msgid "reusable"
msgstr "再利用"

#: blocks/pattern/block.json
msgctxt "block keyword"
msgid "slug"
msgstr "スラッグ"

#: blocks/pattern/block.json
msgctxt "block description"
msgid "Displays a synced pattern looked up by its name, or by its slug if no pattern has that name."
msgstr "名前で同期パターンを探して表示します。その名前のパターンがなければ、スラッグで探します。"
