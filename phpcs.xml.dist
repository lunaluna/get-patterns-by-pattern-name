<?xml version="1.0"?>
<ruleset name="Get Patterns by Pattern Name">
    <description>Coding standard for the Get Patterns by Pattern Name plugin.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <!-- 同梱ライブラリは独自プレフィックス(l2dwpghul)を持ち、自リポジトリの CI で別途検証済み. -->
    <exclude-pattern>/lib/*</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="./"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>

    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress-Docs">
        <!-- テストメソッドは名前が自己文書的なため、docblock 必須ルールは適用しない. -->
        <exclude-pattern>/tests/*</exclude-pattern>
    </rule>

    <!-- block.json の editorScript(file:./index.js)の隣にある index.asset.php は、WP が決めたファイル名なので変えられない. -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>/blocks/*/index.asset.php</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.8"/>

    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="gpbpn"/>
                <element value="get_pattern_by_name"/>
                <element value="get_pattern_by_slug"/>
            </property>
        </properties>
    </rule>
</ruleset>
